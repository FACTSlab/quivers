# Hand-written InverseWishart fixture (matrix family).
object Row : FinSet 3
object Col : FinSet 3
object Obs : Real 9
program inversewishart_fixture : Obs -> Obs
    sample sigma <- InverseWishart(4.0, [[1.0, 0.0, 0.0], [0.5, 1.0, 0.0], [0.0, 0.5, 1.0]]) [over=[Row, Col]]
    return sigma
export inversewishart_fixture
