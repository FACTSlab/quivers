# Hand-written GP fixture (function-space family).
# The kernel option chooses the covariance family; length_scale
# initialises the kernel's hyperparameter (positive, learnable).
object Idx : FinSet 8
object Obs : Real 1
morphism gp_kernel : Idx -> Obs [role=kernel, kernel=rbf, length_scale=1.0] ~ GP
program gp_fixture : Idx -> Obs
    sample f <- gp_kernel
    return f
export gp_fixture
