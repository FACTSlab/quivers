# Exercises LetExprList (literal list of elements).
object Obs : FinSet 4
program prog : Obs -> Obs
    sample a <- Normal(loc=0.0, scale=1.0)
    sample b <- Normal(loc=0.0, scale=1.0)
    let pair = [a, b]
    let total = a + b
    observe y <- Normal(loc=total, scale=1.0)
    return pair
export prog
