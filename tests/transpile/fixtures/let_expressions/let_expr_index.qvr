# Exercises LetExprIndex (subscript / array indexing).
object Coef : FinSet 3
object Obs : FinSet 4
program prog : Obs -> Obs
    sample x <- Normal(loc=0.0, scale=1.0)
    sample coefs : Coef <- Normal(loc=0.0, scale=1.0)
    let pick = coefs[0]
    let scaled = pick * x
    observe y <- Normal(loc=scaled, scale=1.0)
    return pick
export prog
