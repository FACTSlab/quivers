# Exercises EncoderDecl (PYTHON_DEEP tier construct).
signature LF
    sorts
        Term : object [dim=16]
    constructors
        App : Term, Term -> Term
encoder enc : LF
    dim Term = 16
object Resp : FinSet 4
program prog : Resp -> Resp
    sample x <- Bernoulli(0.5)
    return x
export prog
