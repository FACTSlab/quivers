# TruncatedNormal recovery: bounded-support latent stress test.
#
# Prior:        mu ~ Uniform(0.0, 1.0)
# Likelihood:   y_i ~ TruncatedNormal(mu, 0.2, 0.0, 1.0)
#
# Every observation lies in [0, 1] by construction; the posterior
# over mu is supported on (0, 1) and is sharply peaked once N is
# moderate. Tier-6 stress for guides whose bijector must respect
# the unit-interval support (sigmoid for mu) and whose likelihood
# evaluation must use the correct truncated log-density.
object Obs : FinSet 60
program truncated_normal_recovery : Obs -> Obs
    sample mu <- Uniform(0.0, 1.0)
    observe y : Obs <- TruncatedNormal(mu, 0.2, 0.0, 1.0)
    return mu
export truncated_normal_recovery
