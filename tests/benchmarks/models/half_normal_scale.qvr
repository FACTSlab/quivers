# HalfNormal scale recovery: positive-support latent stress test.
#
# Prior:        sigma ~ HalfNormal(2.0)
# Likelihood:   y_i ~ Normal(0.0, sigma)
#
# The posterior for sigma is conjugate (HalfNormal prior is conjugate
# to Normal-with-known-mean likelihood via the variance):
#     p(sigma^2 | y) ∝ sigma^{-N} exp(-Σy²/(2 sigma²)) exp(-sigma²/8)
#
# The posterior moments are computed in references.py via numerical
# integration. Tier-6 constrained-support benchmark: every sample
# must lie in (0, ∞); the guide-side bijector is exp / softplus.

object Obs : 80

program half_normal_scale : Obs -> Obs
    sigma <- HalfNormal(2.0)
    observe y : Obs <- Normal(0.0, sigma)
    return sigma

export half_normal_scale
