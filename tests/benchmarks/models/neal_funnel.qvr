# Neal's funnel — a posterior with a pathological scale dependency.
#
# Generative process:
#     v ~ Normal(0, 3)
#     x_i ~ Normal(0, exp(v / 2))   for i = 1..N
#
# The posterior over (v, x_1, ..., x_N) is funnel-shaped: small v
# implies x_i ≈ 0 with very tight spread; large v admits x_i with
# huge spread. HMC needs Riemannian / non-centered reparam to mix;
# mean-field VI cannot capture the scale-of-scale dependency.
# Neal 2003, doi:10.1214/aos/1056562461. Tier-3 hard-geometry
# stress.

object Latent : 9

program neal_funnel : Latent -> Latent
    v <- Normal(0.0, 3.0)
    let sigma = exp(0.5 * v)
    x : Latent <- Normal(0.0, sigma)
    return v

export neal_funnel
