# Eight Schools (non-centered parameterization, scalar measurement sd).
#
# Same generative model as eight_schools_centered but with theta_j
# written as deterministic transforms of independent standard-Normal
# draws eta_j:
#
#     mu  ~ Normal(0, 10)
#     tau ~ HalfCauchy(5)
#     eta_j ~ Normal(0, 1)
#     theta_j = mu + tau * eta_j
#     y_j ~ Normal(theta_j, 12)
#
# Standard fix for the centered-parameterization funnel pathology
# (Betancourt-Girolami 2015). VI / MCMC both converge faster here
# than on the centered form.

object School : 8

program eight_schools_noncentered : School -> School
    mu <- Normal(0.0, 10.0)
    tau <- HalfCauchy(5.0)
    eta : School <- Normal(0.0, 1.0)
    let theta = mu + tau * eta
    observe y : School <- Normal(theta, 12.0)
    return theta

export eight_schools_noncentered
