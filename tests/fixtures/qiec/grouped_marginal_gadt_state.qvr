index Phase = Emitted | Silent

family Obs[A : Type](p : Phase) : Type
    constructor Missing : Obs[A](Silent)
    constructor Seen : A -> Obs[A](Emitted)

define observed_weight[A : Type, p : Phase](o : Obs[A](p)) : Real !{} =
    case o motive (q : Phase) => Real
        Missing =>
            return 0.0
        Seen(value) =>
            return 1.0

object Resp : FinSet 4

object K : FinSet 2

program mixture : Resp -> Resp
    sample pi : K <- Dirichlet(1.0)
    marginalize k : K <- Categorical(pi)
        observe y : Resp <- Categorical(pi)
    return pi

export mixture
