index Status = Observed | Missing

family Measurement(s : Status) : Type
    constructor Present : Real -> Measurement(Observed)
    constructor Absent : Measurement(Missing)

instance random : Random

instance score : Score

define account[s : Status](m : Measurement(s), location : Real, spread : Real) : Real !{random, score} =
    case m motive (t : Status) => Real
        Present(value) =>
            perform score.add(log_prob(Normal(location, spread), value))
            return value
        Absent =>
            let drawn <- perform random.sample[Real](site("predicted"), Normal(location, spread))
            return drawn

object Group : FinSet 3

object Resp : FinSet 6

program hierarchy : Resp -> Resp
    sample mu <- Normal(0.0, 1.0)
    sample tau <- HalfNormal(1.0)
    sample theta : Group <- Normal(mu, tau)
    let rate = exp(theta)
    let expected = rate[idx]
    observe y : Resp <- Normal(expected, 0.5)
    let seen <- account[Observed](construct Present(2.0) as Measurement(Observed), mu, 1.0)
    let held_out <- account[Missing](construct Absent() as Measurement(Missing), mu, 1.0)
    return held_out

export hierarchy
