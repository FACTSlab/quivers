# ================================================================
# Multimodal Type-Logical Grammar
# ================================================================
#
# Multimodal TLG (Moortgat 1997) extends the Lambek calculus
# with unary type constructors ◇ and □ that form a residuated
# pair (◇ ⊣ □). The structural rules associated with each
# modality are controlled by the grammar's structural component;
# here we license modal introduction and elimination, leaving
# additional structural postulates as further rules a user can
# add.
#
# Categories carry slash (`Fwd(X, Y)`, `Bwd(X, Y)`) and modal
# (`Dia(X) ≡ ◇X`, `Box(X) ≡ □X`) constructors. Chart items are
# `span(I, J, X)` triples.

object Term : 16

deduction MMTLG : Term -> Term {
    atoms {
        # Category atoms.
        S, NP, N, VP, PP,
        # Slash + modal constructors.
        Fwd, Bwd, Dia, Box,
        # Chart-item constructor.
        span
    }

    # Right application.
    rule right_app
        : span(I, K, Fwd(A, B)), span(K, J, B)
        |- span(I, J, A)

    # Left application.
    rule left_app
        : span(I, K, B), span(K, J, Bwd(A, B))
        |- span(I, J, A)

    # Modal introduction: A  ⊢  ◇A
    rule dia_intro
        : span(I, J, A)
        |- span(I, J, Dia(A))

    # Modal elimination:  ◇A  ⊢  A
    rule dia_elim
        : span(I, J, Dia(A))
        |- span(I, J, A)

    semiring  LogProb
    start     S
    depth     6
}
