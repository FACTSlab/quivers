# ================================================================
# Event-structure latent-class model
# ================================================================
#
# A four-class latent-class model (telicity × durativity) over
# cloze and proportion responses with crossed random intercepts
# on subject, verb, sense, and item plus an ordinal monotone
# spline for duration.  Ported from
# ~/Projects/supertelicity/analysis/event-structure-induction/models/event-structure-model.stan.
#
# Categorical denotation: the program is a Kern-morphism
#
#     Data -> G(LatentClass × Item)
#
# with vectorised observation kernels accumulating Bernoulli
# log-likelihoods per response, and a program-level
# `marginalize class` step pushing forward through the projection
# π : Φ × C → Φ to integrate out the discrete latent class.
#
# Reuse pattern: a single `continuous` declaration names the
# shared per-level Normal(0, 1) prior; each grouping factor then
# references that morphism by name in its plate-draw step, so the
# prior structure is written once and reused across the eight
# crossed random intercepts.  Hierarchical scale or correlation
# structure can be folded into the named morphism without
# touching the program body.

# Cardinalities (fit-time-determined; placeholders for static parse).
object Verb : 100
object Sense : 50
object Item : 1000
object SubjCloze : 200
object SubjProp : 200
object RespCloze : 5000
object RespProp : 5000

# Shared per-level prior for crossed random intercepts.  Declared
# once and referenced by name in every plate-draw below.
type UnitSpace = Euclidean 1
continuous random_intercept_prior : UnitSpace -> UnitSpace ~ Normal [loc=0.0, scale=1.0]

# Joint cloze/proportion model.
program event_structure : Item -> Item
    # Class-prior cell parameters.
    draw prob_durative ~ Uniform(0.0, 1.0)
    draw prob_telic_given_dur ~ Beta(10.0, 1.0)
    draw prob_telic_given_nodur ~ Beta(1.0, 1.0)

    # Fixed effects + telicity/durativity coefficients.
    draw intercept_cloze ~ Normal(0.0, 1.0)
    draw intercept_prop ~ Normal(0.0, 1.0)
    draw telicity_coef_cloze ~ HalfNormal(1.0)
    draw telicity_coef_prop ~ HalfNormal(1.0)
    draw durativity_coef_prop ~ HalfNormal(1.0)

    # Crossed random intercepts: eight plate-draws, all sharing
    # `random_intercept_prior`.  No restated families, no
    # hand-rolled scale + LKJ + MVN boilerplate per group — the
    # named morphism carries the prior structure.
    draw by_subj_cloze : SubjCloze -> 1 ~ random_intercept_prior
    draw by_verb_cloze : Verb -> 1 ~ random_intercept_prior
    draw by_sense_cloze : Sense -> 1 ~ random_intercept_prior
    draw by_item_cloze : Item -> 1 ~ random_intercept_prior

    draw by_subj_prop : SubjProp -> 1 ~ random_intercept_prior
    draw by_verb_prop : Verb -> 1 ~ random_intercept_prior
    draw by_sense_prop : Sense -> 1 ~ random_intercept_prior
    draw by_item_prop : Item -> 1 ~ random_intercept_prior

    # Ordinal monotone duration coefficients (11 levels) — the
    # cumulative-sum parameterisation guarantees monotonicity.
    draw duration_coef_cloze : Item -> 11 ~ Normal(0.0, 1.0)
    draw duration_coef_prop : Item -> 11 ~ Normal(0.0, 1.0)

    let duration_eff_cloze = cumsum(duration_coef_cloze)
    let duration_eff_prop = cumsum(duration_coef_prop)

    # Per-class predicted log-odds for the cloze and proportion
    # responses.  `marginalize` integrates over the discrete
    # latent class.
    observe cloze_resp[n] ~ Bernoulli(intercept_cloze) for n in RespCloze
    observe prop_resp[n] ~ Bernoulli(intercept_prop) for n in RespProp

    marginalize cloze_resp
    marginalize prop_resp

    return intercept_cloze

output event_structure
