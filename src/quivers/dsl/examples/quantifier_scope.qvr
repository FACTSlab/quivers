# ================================================================
# Quantifier scope via the Continuation monad (Charlow 2020)
# ================================================================
#
# Demonstrates the Phase 6/7 typeclass + algebraic-effects framework:
# generalised quantifiers as Cont-typed denotations whose lifts
# through the residuation calculus give surface vs. inverse scope
# readings.
#
# Surface form mirrors Bumford & Charlow's typeclass-organised
# treatment: the residuated category universe Cat is closed under
# slash + product; effect-typed types T(X) are first-class TypeExpr
# variants (TypeEffectApply); pattern-polymorphic schemas with
# effect-typed parameters are SchemaDecls.
#
# At runtime the parser dispatches jointly on type and effect: at
# each chart cell, base schemas fire on effect-pure cells, lifted
# schemas (auto-generated by class_directed_lifts) fire on
# effect-typed cells, handlers reduce the effect stack at appropriate
# leaves, and registered distributive laws permit effect-stack
# reordering.

# Categorial atoms.
object Atoms = {NP, S, VP, N, PP}

# Residuated universe closed under slash up to depth 2.
object Cat = FreeResiduated(Atoms, depth=2, ops=[slash])

object Token : 256

# ----------------------------------------------------------------
# Base schemas (the Lambek calculus core).
# ----------------------------------------------------------------

# Forward application: (X/Y) * Y -> X
schema forward_app[X, Y : Cat] : (X/Y) * Y -> X

# Backward application: Y * (X\Y) -> X
schema backward_app[X, Y : Cat] : Y * (X\Y) -> X

# ----------------------------------------------------------------
# Lifted schemas (Phase 7 will auto-generate these from the base
# rules via class_directed_lifts; they are spelled out here for
# illustration of the resulting surface).
# ----------------------------------------------------------------

# Applicative lift of forward_app under Continuation:
# Cont_S(X/Y) * Cont_S(Y) -> Cont_S(X)
schema apply_Cont_fwd[X, Y : Cat] : Cont_S(X/Y) * Cont_S(Y) -> Cont_S(X)

# Charlow's scope-extruding bind: a Cont-typed expression takes scope
# over an inner argument by passing through the bind.
schema scope_take[X, Y : Cat] : Cont_S(X) * (X\Y) -> Cont_S(Y)

# ----------------------------------------------------------------
# Lexical assignment: Token -> Cat (a learnable morphism).
# ----------------------------------------------------------------
latent lex : Token -> Cat

# Chart parser combining base + lifted schemas. The user-visible
# `chart_fold(...)` expression is the desugared form of `parser(...)`
# with explicit lex / binary slots; the parser-driven inferences
# automatically pick up category atoms from the FreeResiduated
# universe in scope.
let grammar = parser(
    rules=[forward_app, backward_app, apply_Cont_fwd, scope_take],
    terminal=Token,
    start=S
)

export grammar
