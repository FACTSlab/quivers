# ================================================================
# Quantifier scope via the Continuation monad
# (Bumford & Charlow 2026, *Effect-Driven Interpretation*)
# ================================================================
#
# Generalised quantifiers as Cont-typed denotations whose lifts
# through the residuation calculus give surface vs. inverse
# scope readings. Categories carry slash (`Fwd(X, Y)`, `Bwd(X, Y)`)
# constructors and a unary `Cont(X)` constructor for the
# continuation-typed lift `S/(S/X)` (an answer-type-`S`
# continuation over `X`). Chart items are `span(I, J, X)`.
#
# The deduction below licenses base forward / backward
# application, the applicative lift of forward application
# under `Cont`, and Charlow's scope-extruding bind. Concrete
# answer types are baked into rule names (`Cont(_)` over
# arbitrary `S`); a richer fragment with multiple answer types
# would parameterise the rules over `S`.

object Term : 16

deduction QScope : Term -> Term {
    atoms {
        # Category atoms.
        S, NP, N, VP, PP,
        # Slash + continuation constructors.
        Fwd, Bwd, Cont,
        # Chart-item constructor.
        span
    }

    # Base forward application.
    rule fwd_app
        : span(I, K, Fwd(A, B)), span(K, J, B)
        |- span(I, J, A)

    # Base backward application.
    rule bwd_app
        : span(I, K, B), span(K, J, Bwd(A, B))
        |- span(I, J, A)

    # Applicative lift of forward application under Cont:
    #   Cont(A/B) * Cont(B) ⊢ Cont(A)
    rule fwd_app_cont
        : span(I, K, Cont(Fwd(A, B))), span(K, J, Cont(B))
        |- span(I, J, Cont(A))

    # Pure: A ⊢ Cont(A)
    rule pure_cont
        : span(I, J, A)
        |- span(I, J, Cont(A))

    # Scope-extruding bind: a Cont-typed expression takes scope
    # over an inner argument by absorbing the surrounding context.
    #   Cont(A) * (A\B) ⊢ Cont(B)
    rule scope_take
        : span(I, K, Cont(A)), span(K, J, Bwd(B, A))
        |- span(I, J, Cont(B))

    semiring  LogProb
    start     S
    depth     6
}
