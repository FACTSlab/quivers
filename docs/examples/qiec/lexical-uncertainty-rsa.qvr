# Lexical-Uncertainty Rational Speech Acts
#
# A direct implementation of the specificity-implicature example in
# Bergen, Levy & Goodman (2016), equations 31--34 and Figure 5.
#
# Worlds:
#   0 = all of the students passed
#   1 = some but not all of the students passed
#
# Utterances:
#   0 = "some"
#   1 = "all"
#   2 = the always-true null utterance
#
# Lexica:
#   0 = "some" is true in both worlds
#   1 = "some" means some-but-not-all
#   2 = "some" means all
#
# The source mirrors the RSA recursion: pragmatic_speaker calls
# literal_listener for each alternative, and lexical_listener calls
# the speaker under each possible lexicon. False cells use
# the paper's 10^-6 numerical relaxation (section 4.3).

index Evidence = Answered | Predict

family Interpretation(e : Evidence) : Type
    constructor Chose : Int -> Interpretation(Answered)
    constructor Unanswered : Interpretation(Predict)

instance random : Random
instance score : Score

define interpret[e : Evidence](response : Interpretation(e), p_all : Real, p_not_all : Real) : Int !{random, score} =
    let listener = Categorical([p_all, p_not_all])
    case response motive (t : Evidence) => Int
        Chose(world) =>
            perform score.add(log_prob(listener, world))
            return world
        Unanswered =>
            let world <- perform random.sample[Int](site("interpretation"), listener)
            return world

define literal_listener(meaning : Tensor[Real]([2]), world_prior : Tensor[Real]([2])) : Tensor[Real]([2]) !{} =
    let mass_all = meaning[0] * world_prior[0]
    let mass_not_all = meaning[1] * world_prior[1]
    let normalizer = mass_all + mass_not_all
    return [mass_all / normalizer, mass_not_all / normalizer]

define pragmatic_speaker(some_meaning : Tensor[Real]([2]), all_meaning : Tensor[Real]([2]), world_prior : Tensor[Real]([2]), alpha : Real) : Tensor[Real]([2, 3]) !{} =
    let null_meaning = [1.0, 1.0]
    let l0_some <- literal_listener(some_meaning, world_prior)
    let l0_all <- literal_listener(all_meaning, world_prior)
    let l0_null <- literal_listener(null_meaning, world_prior)
    let some_all = exp(alpha * (log(l0_some[0]) - 1.0))
    let all_all = exp(alpha * (log(l0_all[0]) - 1.0))
    let null_all = exp(alpha * (log(l0_null[0]) - 5.0))
    let z_all = some_all + all_all + null_all
    let some_not_all = exp(alpha * (log(l0_some[1]) - 1.0))
    let all_not_all = exp(alpha * (log(l0_all[1]) - 1.0))
    let null_not_all = exp(alpha * (log(l0_null[1]) - 5.0))
    let z_not_all = some_not_all + all_not_all + null_not_all
    return [[some_all / z_all, all_all / z_all, null_all / z_all], [some_not_all / z_not_all, all_not_all / z_not_all, null_not_all / z_not_all]]

define lexical_speakers(alpha : Real, epsilon : Real) : Tensor[Real]([3, 2]) !{} =
    let world_prior = [0.5, 0.5]
    let all_meaning = [1.0, epsilon]
    let broad_some = [1.0, 1.0]
    let lower_some = [epsilon, 1.0]
    let upper_some = [1.0, epsilon]
    let broad <- pragmatic_speaker(broad_some, all_meaning, world_prior, alpha)
    let lower <- pragmatic_speaker(lower_some, all_meaning, world_prior, alpha)
    let upper <- pragmatic_speaker(upper_some, all_meaning, world_prior, alpha)
    let broad_all = broad[0]
    let broad_not_all = broad[1]
    let lower_all = lower[0]
    let lower_not_all = lower[1]
    let upper_all = upper[0]
    let upper_not_all = upper[1]
    return [[broad_all[0], broad_not_all[0]], [lower_all[0], lower_not_all[0]], [upper_all[0], upper_not_all[0]]]

define lexical_listener(alpha : Real, epsilon : Real) : Tensor[Real]([2]) !{} =
    let speakers <- lexical_speakers(alpha, epsilon)
    let broad = speakers[0]
    let lower = speakers[1]
    let upper = speakers[2]
    let likelihood_all = (broad[0] + lower[0] + upper[0]) / 3.0
    let likelihood_not_all = (broad[1] + lower[1] + upper[1]) / 3.0
    let mass_all = 0.5 * likelihood_all
    let mass_not_all = 0.5 * likelihood_not_all
    let normalizer = mass_all + mass_not_all
    return [mass_all / normalizer, mass_not_all / normalizer]

object CommunicationState : FinSet 6
object Event : FinSet 1
object Posterior : Real 2

program lexical_uncertainty_rsa : Event -> Posterior
    sample raw_alpha <- Normal(0.0, 1.0)
    let alpha = exp(raw_alpha)
    let epsilon = 0.000001
    let posterior <- lexical_listener(alpha, epsilon)
    let p_all = posterior[0]
    let p_not_all = posterior[1]
    let choice = int(listener_choice)
    let response <- interpret[Answered](construct Chose(choice) as Interpretation(Answered), p_all, p_not_all)
    let speakers <- lexical_speakers(alpha, epsilon)
    let broad = speakers[0]
    let lower = speakers[1]
    let upper = speakers[2]
    let speaker_some = factor state : CommunicationState in {
        0 -> broad[0],
        1 -> broad[1],
        2 -> lower[0],
        3 -> lower[1],
        4 -> upper[0],
        5 -> upper[1],
    }
    let state_prior = factor state : CommunicationState in 0.1666666667

    marginalize state : CommunicationState <- Categorical(state_prior) [reduction=logsumexp]
        let p_some = speaker_some[state]
        observe heard_some : Event <- Bernoulli(p_some)

    return posterior

export lexical_uncertainty_rsa
