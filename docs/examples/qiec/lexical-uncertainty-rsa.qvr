# Lexical-Uncertainty Rational Speech Acts
#
# Equations 31--34 and the specificity-implicature example in Figure 5 of
# Bergen, Levy & Goodman (2016). The two worlds are ALL and SOME-BUT-NOT-ALL;
# the three utterances are "some", "all", and the null utterance. The three
# lexica leave "some" unenriched, strengthen it to SOME-BUT-NOT-ALL, or
# strengthen it to ALL. The program extends the paper's figure by learning
# its speaker-rationality parameter from interpretation choices.

define normalize_worlds(weights : Tensor[Real]([2])) : Tensor[Real]([2]) !{} =
    let total = fold(weights, 0.0, sum -> weight -> sum + weight)
    return map(weights, weight -> weight / total)

define literal_listener(meaning : Tensor[Real]([2]), world_prior : Tensor[Real]([2])) : Tensor[Real]([2]) !{} =
    let masses = map([0, 1], world -> meaning[world] * world_prior[world])
    let listener <- normalize_worlds(masses)
    return listener

define utterance_utility(listeners : Tensor[Real]([3, 2]), costs : Tensor[Real]([3]), world : Int, utterance : Int, alpha : Real) : Real !{} =
    let listener = listeners[utterance]
    return alpha * (log(listener[world]) - costs[utterance])

define speaker_at_world(listeners : Tensor[Real]([3, 2]), costs : Tensor[Real]([3]), world : Int, alpha : Real) : Tensor[Real]([3]) !{} =
    let utilities <- traverse(
        [0, 1, 2],
        utterance -> utterance_utility(listeners, costs, world, utterance, alpha),
    )
    let peak = max(max(utilities[0], utilities[1]), utilities[2])
    let weights = map(utilities, utility -> exp(utility - peak))
    let normalizer = fold(weights, 0.0, total -> weight -> total + weight)
    return map(weights, weight -> weight / normalizer)

define pragmatic_speaker(meanings : Tensor[Real]([3, 2]), costs : Tensor[Real]([3]), world_prior : Tensor[Real]([2]), alpha : Real) : Tensor[Real]([2, 3]) !{} =
    let listeners <- traverse(meanings, meaning -> literal_listener(meaning, world_prior))
    let speaker <- traverse([0, 1], world -> speaker_at_world(listeners, costs, world, alpha))
    return speaker

define specificity_speaker(some_meaning : Tensor[Real]([2]), world_prior : Tensor[Real]([2]), alpha : Real, epsilon : Real) : Tensor[Real]([2, 3]) !{} =
    let meanings = [some_meaning, [1.0, epsilon], [1.0, 1.0]]
    let costs = [1.0, 1.0, 5.0]
    let speaker <- pragmatic_speaker(meanings, costs, world_prior, alpha)
    return speaker

define some_probabilities(speaker : Tensor[Real]([2, 3])) : Tensor[Real]([2]) !{} =
    return map(speaker, utterance_distribution -> utterance_distribution[0])

define lexical_speakers(world_prior : Tensor[Real]([2]), alpha : Real, epsilon : Real) : Tensor[Real]([3, 2]) !{} =
    let some_meanings = [[1.0, 1.0], [epsilon, 1.0], [1.0, epsilon]]
    let speakers <- traverse(
        some_meanings,
        some_meaning -> specificity_speaker(some_meaning, world_prior, alpha, epsilon),
    )
    let probabilities <- traverse(
        speakers,
        speaker -> some_probabilities(speaker),
    )
    return probabilities

define lexicon_marginal_likelihood(speakers : Tensor[Real]([3, 2]), lexicon_prior : Tensor[Real]([3]), world : Int) : Real !{} =
    let weighted_likelihoods = map(
        [0, 1, 2],
        lexicon -> lexicon_prior[lexicon] * speakers[lexicon, world],
    )
    return fold(weighted_likelihoods, 0.0, sum -> likelihood -> sum + likelihood)

define lexical_listener(speakers : Tensor[Real]([3, 2]), world_prior : Tensor[Real]([2]), lexicon_prior : Tensor[Real]([3])) : Tensor[Real]([2]) !{} =
    let likelihoods <- traverse(
        [0, 1],
        world -> lexicon_marginal_likelihood(speakers, lexicon_prior, world),
    )
    let masses = map([0, 1], world -> world_prior[world] * likelihoods[world])
    let listener <- normalize_worlds(masses)
    return listener

define specificity_listener(alpha : Real, epsilon : Real) : Tensor[Real]([2]) !{} =
    let world_prior = [0.5, 0.5]
    let lexicon_prior = [0.3333333333333333, 0.3333333333333333, 0.3333333333333333]
    let speakers <- lexical_speakers(world_prior, alpha, epsilon)
    let listener <- lexical_listener(speakers, world_prior, lexicon_prior)
    return listener

object Trial : FinSet 200
object Posterior : Real 2

program fit_specificity_listener : Trial -> Posterior
    sample raw_alpha <- Normal(0.0, 1.0)
    let alpha = exp(raw_alpha)
    let listener <- specificity_listener(alpha, 0.000001)
    let p_some_not_all = listener[1]
    observe chose_some_not_all : Trial <- Bernoulli(p_some_not_all)
    return listener

export fit_specificity_listener
