# Bayesian Linear Regression
#
# A two-parameter linear model with a HalfCauchy prior on the
# noise scale and Normal priors on the regression coefficients:
#
#   sigma  ~ HalfCauchy(2.0)
#   beta_0 ~ Normal(0.0, 5.0)        intercept
#   beta_1 ~ Normal(0.0, 2.0)        slope
#   mu     = beta_0 + beta_1 * x
#   y      ~ Normal(mu, sigma)
#
# Exercises the core sample / let / observe pattern that every
# richer model in the gallery composes from.

object Predictor : 1
object Response : 1

program bayesian_regression : Predictor -> Response
    sigma <- HalfCauchy(2.0)
    beta_0 <- Normal(0.0, 5.0)
    beta_1 <- Normal(0.0, 2.0)
    x <- Normal(0.0, 1.0)
    let mu = beta_0 + beta_1 * x
    observe y : Response <- Normal(mu, sigma)
    return y

export bayesian_regression
