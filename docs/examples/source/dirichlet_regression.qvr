# ================================================================
# Dirichlet Regression
# ================================================================
#
# A Dirichlet regression ([Maier 2014]
# (https://doi.org/10.32614/CRAN.package.DirichletReg)) for
# compositional response variables on the K-dimensional
# probability simplex.  The model uses K = 3 categories and
# exploits the Gamma / Dirichlet relationship: independent
# Gamma draws with shapes `(alpha_1, ..., alpha_K)` and unit rate
# normalise to a Dirichlet sample on the K-simplex.  Each
# category's log-shape is a linear function of the predictor:
#
#   beta_0_k, beta_1_k ~ Normal(0, 2)        for k in 1..K
#   alpha_{n, k}       = exp(beta_0_k + beta_1_k * x_n)
#   tally_{n, k}       ~ Gamma(alpha_{n, k}, 1)
#   y_{n, k}           = tally_{n, k} / sum_j tally_{n, j}
#
# The K coefficient plates are gathered through `cat_idx` so the
# program scales to arbitrary K without rewriting the body; the
# runtime supplies the raw Gamma-scaled component tallies and
# the normalisation is recovered downstream.  Distinguishing
# feature: per-category plate-gather makes the K-dimensional
# simplex codomain a one-line variation on the univariate
# regression body.

object Item : 200
object Cat : 3
object Resp : 600

program dirichlet_regression : Resp -> Resp
    beta_0 : Cat <- Normal(0.0, 2.0)
    beta_1 : Cat <- Normal(0.0, 2.0)

    x : Resp <- Normal(0.0, 1.0)
    let b0 = beta_0[cat_idx]
    let b1 = beta_1[cat_idx]
    let alpha = exp(b0 + b1 * x)

    observe tally : Resp <- Gamma(alpha, 1.0)
    return beta_1

export dirichlet_regression
