# ================================================================
# Weighted Combinatory Categorial Grammar (CCG)
# ================================================================
#
# A learnable weighted CCG parser declared as an agenda-based
# weighted deduction over chart items. CCG's structural rules
# are:
#
#   - Forward / backward application      (evaluation)
#   - Forward / backward composition      (harmonic_composition)
#   - Forward / backward crossed comp.    (crossed_composition)
#
# Each is one sequent rule below. `Fwd(X, Y)` constructs the
# forward-slash category `X/Y`; `Bwd(X, Y)` constructs the
# backward-slash category `X\Y`. The compiler treats every
# identifier listed in `atoms { … }` as a nullary or parametric
# constructor; single-uppercase identifiers (`X`, `Y`, `Z`, `I`,
# `J`, `K`) bind as pattern variables.
#
# Chart items are `span(I, J, X)` triples covering tokens
# `[I, J)` with category `X`. The semiring is `LogProb` for
# differentiable inside scores.
#
# Categorical perspective: CCG is the internal language of a
# closed monoidal category. The slashes are internal homs;
# application is the counit of the hom-tensor adjunction;
# composition is composition of internal hom morphisms.

object Term : 16

deduction CCG : Term -> Term {
    atoms {
        # Category atoms.
        NP, S, N, VP, PP,
        # Slash constructors.
        Fwd, Bwd,
        # Chart-item constructor.
        span
    }

    # Forward application: X/Y, Y => X
    rule fwd_app
        : span(I, K, Fwd(X, Y)), span(K, J, Y)
        |- span(I, J, X)

    # Backward application: Y, X\Y => X
    rule bwd_app
        : span(I, K, Y), span(K, J, Bwd(X, Y))
        |- span(I, J, X)

    # Forward composition: X/Y, Y/Z => X/Z
    rule fwd_comp
        : span(I, K, Fwd(X, Y)), span(K, J, Fwd(Y, Z))
        |- span(I, J, Fwd(X, Z))

    # Backward composition: Y\Z, X\Y => X\Z
    rule bwd_comp
        : span(I, K, Bwd(Y, Z)), span(K, J, Bwd(X, Y))
        |- span(I, J, Bwd(X, Z))

    # Forward crossed composition: X/Y, Y\Z => X\Z
    rule fwd_xcomp
        : span(I, K, Fwd(X, Y)), span(K, J, Bwd(Y, Z))
        |- span(I, J, Bwd(X, Z))

    # Backward crossed composition: Y/Z, X\Y => X/Z
    rule bwd_xcomp
        : span(I, K, Fwd(Y, Z)), span(K, J, Bwd(X, Y))
        |- span(I, J, Fwd(X, Z))

    semiring  LogProb
    start     S
    depth     6
}
