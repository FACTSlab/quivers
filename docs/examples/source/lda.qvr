# ================================================================
# Latent Dirichlet Allocation
# ================================================================
#
# The canonical topic model (Blei, Ng & Jordan 2003): each
# document is a mixture of K topics, each topic is a distribution
# over the vocabulary, and each observed word is generated by
# first drawing a per-word topic from the document-specific topic
# mixture and then drawing a word from that topic's vocabulary
# mixture.
#
#   theta : Doc        -- document-topic concentration
#   phi   : Topic      -- topic-word concentration
#   z     : Topic      -- per-word topic (marginalised)
#   w     : Word       -- observed word
#
# The discrete per-word topic assignment z is integrated out by
# the enclosing grouped `marginalize` block.  The body's per-word
# observation depends on the topic-bound `phi` parameter; the
# runtime accumulates a log-sum-exp over the K topics at every
# word position.  The `via word_idx` clause names the per-word
# fibration into the Doc grouping plate.

object Doc : 50
object Topic : 8
object Word : 1000

program lda : Word -> Word
    # Document-topic and topic-word concentrations.
    theta : Doc <- HalfNormal(1.0)
    phi : Topic <- HalfNormal(1.0)

    # Per-word fibration into the Doc grouping plate (a per-word
    # document index supplied at runtime via the observations
    # dict).
    word_idx : Word <- HalfNormal(1.0)

    # Continuous concentration shared across documents; SVI fits
    # this jointly with the per-class log-weights inside the
    # marginalize block.
    conc <- Normal(0.0, 1.0)

    # Marginalise the per-word topic assignment.  The Dirichlet
    # concentration is the Topic-shaped `phi` vector; the runtime
    # log-sum-exps over the K topics at every word position.
    marginalize z : Topic <- Dirichlet(phi)
        over Doc
        in {
            observe w : Word via word_idx <- Normal(conc, 1.0)
        }
    return theta

export lda
