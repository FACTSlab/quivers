# ================================================================
# Latent Dirichlet Allocation (Gaussian-LDA relaxation)
# ================================================================
#
# The classical topic model (Blei, Ng & Jordan 2003) draws each
# word's topic from the document-topic mixture, then draws the
# word itself from the topic-vocabulary mixture.  The per-word
# topic assignment is integrated out, yielding a per-word marginal
#
#   p(w | theta_d, phi) = sum_k theta_d[k] * phi_k[w].
#
# Both the topic assignment and the word are discrete and the
# canonical observation family is categorical over the vocabulary.
# QVR's inline distribution surface admits per-dimension
# independent families (Normal, Gamma, HalfNormal, ...) but not
# Categorical, which produces a categorical-output kind.  This
# example therefore realises a *Gaussian-LDA* relaxation
# (Das, Zaheer & Dyer 2015): each word is replaced by a learned
# word embedding, each topic by a learned topic embedding, and
# the per-word emission is a Normal whose mean is the topic
# embedding selected by the per-word topic latent.  The discrete
# topic assignment is still integrated out, so the marginalize
# block's mathematical role is unchanged; only the emission
# family changes from Categorical to Normal.
#
# Generative structure
#
#   theta : Doc                  -- document-topic concentration
#   phi   : Topic                -- per-topic embedding mean
#   psi   : Topic                -- per-topic embedding scale
#   z     : Topic                -- per-word topic (marginalized)
#   w     : Word                 -- observed word embedding,
#                                   conditional on z
#
# Per-word marginal:
#
#   p(w_{d,n}) = sum_k theta_d[k] * Normal(w_{d,n}; phi[k], psi[k]).

object Doc : 50
object Topic : 8
object Word : 1000

program lda : Word -> Word
    # Document-topic and topic-embedding concentrations.
    # Dirichlet concentration on the Topic simplex.  The classical
    # LDA has one theta_d per document; this Gaussian-LDA
    # relaxation shares a single Topic-shaped concentration across
    # the corpus and integrates topic assignment per word.
    theta : Topic <- HalfNormal(1.0)

    # Per-topic emission parameters: the topic embedding mean and
    # scale.  The word likelihood conditional on z = k is
    # Normal(phi[k], psi[k]).
    phi : Topic <- Normal(0.0, 5.0)
    psi : Topic <- HalfNormal(1.0)

    # Per-word fibration into the Doc grouping plate (a per-word
    # document index supplied at runtime via the observations
    # dict).
    word_idx : Word <- HalfNormal(1.0)

    # Marginalize the per-word topic assignment.  The body
    # references the marginalized variable `z` by gathering
    # `phi[z]` and `psi[z]` at every word position, so the body's
    # per-word likelihood genuinely depends on the topic.
    marginalize z : Topic <- Dirichlet(theta)
        over Doc
        in {
            let phi_nk = factor n : Word, k : Topic in phi[k]
            let psi_nk = factor n : Word, k : Topic in psi[k]
            observe w : Word via word_idx <- Normal(phi_nk, psi_nk)
        }
    return theta

export lda
