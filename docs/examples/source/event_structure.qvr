# ================================================================
# Event-structure latent-class model
# ================================================================
#
# A four-class latent-class model (telicity × durativity) over
# cloze and proportion responses with crossed random intercepts
# on subject, verb, sense, and item plus an ordinal monotone
# spline for duration.
#
# Categorical denotation: the program is a Kern-morphism
#
#     Data -> G(LatentClass × Item)
#
# with vectorised observation kernels accumulating Bernoulli
# log-likelihoods per response, and a program-level
# `marginalize class` step pushing forward through the projection
# π : Φ × C → Φ to integrate out the discrete latent class.
#
# Random-intercepts reuse pattern: declare the random-intercepts
# structure once as a *parametric program* polymorphic over the
# grouping object `G` and the hyperprior `scale`, then call it
# per grouping factor.  Each call site instantiates a fresh copy
# of the template's latents (its own σ, its own per-level v),
# realising the dependent kernel
#
#     Π (G : FinSet) Π (scale : Real). Kern(G, 1).
#
# This is the right categorical handle for prior reuse: a named
# `continuous` morphism cannot bundle a fresh scale draw per call
# because morphism reference is invocation, not instantiation;
# parametric programs *are* instantiated freshly at each call.

# Cardinalities (fit-time-determined; placeholders for static parse).
object Verb : 100
object Sense : 50
object Item : 1000
object SubjCloze : 200
object SubjProp : 200
object RespCloze : 5000
object RespProp : 5000
# Four cells of the telicity × durativity cross-classification.
object Class4 : 4

# Parametric random-intercepts template: one scale hyperprior +
# a per-level Normal(0, σ) plate, polymorphic over the grouping
# object G and the half-normal scale hyperparameter.
program random_intercepts (G : FinSet, scale : Real) : G -> 1
    sigma <- HalfNormal(scale)
    v : G <- Normal(0.0, sigma)
    return v

# Joint cloze/proportion model.
program event_structure : Item -> Item
    # Class-prior cell parameters.
    prob_durative <- Uniform(0.0, 1.0)
    prob_telic_given_dur <- Beta(10.0, 1.0)
    prob_telic_given_nodur <- Beta(1.0, 1.0)

    # Fixed effects + telicity/durativity coefficients.
    intercept_cloze <- Normal(0.0, 1.0)
    intercept_prop <- Normal(0.0, 1.0)
    telicity_coef_cloze <- HalfNormal(1.0)
    telicity_coef_prop <- HalfNormal(1.0)
    durativity_coef_prop <- HalfNormal(1.0)

    # Crossed random intercepts: each call to `random_intercepts`
    # produces a fresh σ and a fresh per-level plate.  The shared
    # structure (HalfNormal scale + Normal(0, σ) per level) is
    # written once in the template.
    by_subj_cloze <- random_intercepts(SubjCloze, 1.0)
    by_verb_cloze <- random_intercepts(Verb, 1.0)
    by_sense_cloze <- random_intercepts(Sense, 1.0)
    by_item_cloze <- random_intercepts(Item, 1.0)

    by_subj_prop <- random_intercepts(SubjProp, 1.0)
    by_verb_prop <- random_intercepts(Verb, 1.0)
    by_sense_prop <- random_intercepts(Sense, 1.0)
    by_item_prop <- random_intercepts(Item, 1.0)

    # Ordinal monotone duration coefficients (11 levels).  The
    # cumulative-sum parameterisation yields a monotone-increasing
    # spline iff the increments have nonnegative support, so the
    # per-step increments are drawn from a half-normal.  `cumsum`
    # then maps positive increments to monotone partial sums.
    duration_incr_cloze : Item <- HalfNormal(1.0)
    duration_incr_prop : Item <- HalfNormal(1.0)

    let duration_eff_cloze = cumsum(duration_incr_cloze)
    let duration_eff_prop = cumsum(duration_incr_prop)

    # Response → item fibrations.  Supplied at fit time as long
    # tensors of group indices (one per response row).  Declared as
    # half-normal plates here so the static surface parses; the
    # runtime overrides them with the observed mappings.
    item_cloze_idx : RespCloze <- HalfNormal(1.0)
    item_prop_idx : RespProp <- HalfNormal(1.0)

    # Class-prior probabilities over the four telicity × durativity
    # cells.  Drawn as a Dirichlet on the 4-simplex; the convention
    # is that the concentration vector is supplied as a previously
    # drawn plate variable.
    telicity_durativity_probs : Class4 <- Dirichlet(prob_durative)

    # Per-row per-class log-likelihoods for the cloze and proportion
    # responses share a single per-item class indicator: both
    # response axes scatter into the same per-(item, class)
    # accumulator before the log-sum-exp.  The block declares
    # one grouping plate (`over Item`); each `observe` inside
    # carries its own `via <idx>` clause naming the response
    # plate's fibration into the shared grouping plate.
    #
    # Categorical denotation: the right Kan extension along the
    # coproduct fibration `RespCloze + RespProp -> Item` in Kern,
    # followed by log-sum-exp over the class axis weighted by the
    # categorical prior, summed over items.
    marginalize class : Class4 <- Dirichlet(telicity_durativity_probs)
        over Item
        in {
            observe cloze_resp : RespCloze via item_cloze_idx
                <- Normal(intercept_cloze, 1.0)
            observe prop_resp  : RespProp  via item_prop_idx
                <- Normal(intercept_cloze, 1.0)
        }

    return intercept_cloze

export event_structure
