# ================================================================
# Stochastic Volatility Model
# ================================================================
#
# The canonical log-volatility model ([Kim, Shephard, and Chib
# 1998](https://doi.org/10.1111/1467-937X.00050)):
#
#   mu     ~ Normal(0, 10)
#   phi    ~ Uniform(-1, 1)
#   sigma_h ~ HalfCauchy(2.5)
#   h_t    ~ Normal(mu + phi * (h_{t-1} - mu), sigma_h)
#   r_t    ~ Normal(0, exp(h_t / 2))
#
# Returns r_t are mean-zero Normal with time-varying scale set by
# the latent log-volatility h_t, which itself follows an AR(1)
# chain centred on mu. The runtime conditions on the observed
# return series indexed by `Step` and recovers a posterior over
# (mu, phi, sigma_h) along with the latent volatility plate.

object Step : 200

program stochastic_volatility : Step -> Step
    mu <- Normal(0.0, 10.0)
    phi <- Uniform(-1.0, 1.0)
    sigma_h <- HalfCauchy(2.5)

    h_prev : Step <- Normal(mu, 1.0)
    let h_mean = mu + phi * (h_prev - mu)
    h : Step <- Normal(h_mean, sigma_h)

    let scale = exp(0.5 * h)
    observe r : Step <- Normal(0.0, scale)
    return phi

export stochastic_volatility
