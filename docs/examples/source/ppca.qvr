# ================================================================
# Probabilistic Principal Component Analysis
# ================================================================
#
# Probabilistic PCA (Tipping & Bishop 1999) factors a data matrix
# Y : Item -> ObsDim through a low-rank loading matrix
# W : LatentDim -> ObsDim and a per-item latent code
# Z : Item -> LatentDim, so the model mean is the composition
#
#     ppca = Z >> W : Item -> ObsDim.
#
# The loading matrix carries a matrix-normal prior via the
# morphism-valued surface
#
#     latent W : LatentDim -> ObsDim
#         ~ MatrixNormal(0.0, 1.0, 1.0) over (dom, cod)
#
# whose Kronecker covariance V (x) U expresses independent row
# and column correlation. The per-item latent Z is a plain
# learnable matrix; in classical PPCA its rows are standard
# normal, recoverable here as a unit-scale init on Z.
#
# Working under `algebra real` makes the composition `Z >> W` a
# real-valued matmul: the (Item, ObsDim) entry of the model
# tensor is sum_k Z[i, k] * W[k, d], exactly the canonical PPCA
# mean. The model is identifiable up to a K x K orthogonal
# rotation of W; the maximum-likelihood W recovers the leading-K
# principal components scaled by sqrt(lambda_k - sigma^2).

algebra real

object LatentDim : 2
object ObsDim : 3
object Item : 200

# Per-item latent code, K = 2 dimensions per Item.
latent Z : Item -> LatentDim

# Loading matrix with a matrix-normal prior.
latent W : LatentDim -> ObsDim ~ MatrixNormal(0.0, 1.0, 1.0) over (dom, cod)

# PPCA mean as composition: Z @ W under real-algebra matmul.
let ppca = Z >> W

export ppca
