# ================================================================
# Multi-Layer Bayesian Transformer Language Model
# ================================================================
#
# A multi-layer Bayesian transformer used as a causal language
# model. Token indices are embedded into a Latent representation,
# passed through four independent attention + feed-forward layers
# via stack(layer, 4), and projected back onto the Token
# vocabulary via a Categorical lm_head.
#
# Architecture (4 independent layers via stack, each containing):
#   1. Multi-head attention (4 heads via fan)
#   2. Residual continuous morphism
#   3. Two-stage feed-forward block
#   4. Residual continuous morphism
#
# The program runs the backbone to obtain a per-position Latent
# representation, then observes the next-token target under a
# Categorical likelihood parameterised by lm_head.

object Token : 256

type Latent = Euclidean 64
type HeadOut = Euclidean 16
type FFHidden = Euclidean 128

embed tok_embed : Token -> Latent

kernel head[4] : Latent -> HeadOut ~ Normal [scale=0.1]
kernel attn_proj : Latent -> Latent ~ Normal [scale=0.1]
kernel ff_up : Latent -> FFHidden ~ Normal
kernel ff_down : FFHidden -> Latent ~ Normal [scale=0.1]
kernel residual_attn : Latent -> Latent ~ Normal [scale=0.01]
kernel residual_ff : Latent -> Latent ~ Normal [scale=0.01]
kernel lm_head : Latent -> Token ~ Categorical

let layer = fan(head) >> attn_proj >> residual_attn >> ff_up >> ff_down >> residual_ff
let backbone = tok_embed >> stack(layer, 4)

program transformer_lm : Token -> Token
    h <- backbone
    observe next_token : Token <- lm_head(h)
    return next_token

export transformer_lm
