# ================================================================
# Weighted Type-Logical Grammar (Lambek calculus)
# ================================================================
#
# The non-commutative Lambek calculus L, expressed as an
# agenda-based weighted deduction. Categories carry slash
# (`Fwd(X, Y) ≡ X/Y`, `Bwd(X, Y) ≡ X\Y`) and tensor
# (`Tns(X, Y) ≡ X⊗Y`) constructors. Chart items are
# `span(I, J, X)` triples covering tokens `[I, J)` with
# category `X`.
#
# Lambek rules realised below:
#   - right / left application (modus ponens)
#   - product introduction      A, B  ⊢  A⊗B
#   - product elimination       A⊗B   ⊢  A   and   A⊗B   ⊢  B
#
# The Lambek calculus is resource-sensitive (every hypothesis is
# used exactly once) and order-preserving (no permutation). It
# is the internal logic of a residuated monoidal category
# (biclosed monoidal category): the residuation laws
#
#   A ⊗ B  ⊢  C   iff   A  ⊢  C/B   iff   B  ⊢  A\C
#
# make L the free residuated monoid over its atoms.

object Term : 16

deduction Lambek : Term -> Term {
    atoms {
        # Category atoms.
        S, NP, N, VP, PP,
        # Slash + tensor constructors.
        Fwd, Bwd, Tns,
        # Chart-item constructor.
        span
    }

    # Right application: A/B, B  ⊢  A
    rule right_app
        : span(I, K, Fwd(A, B)), span(K, J, B)
        |- span(I, J, A)

    # Left application:  B, A\B  ⊢  A
    rule left_app
        : span(I, K, B), span(K, J, Bwd(A, B))
        |- span(I, J, A)

    # Product introduction: A, B  ⊢  A⊗B
    rule tensor_intro
        : span(I, K, A), span(K, J, B)
        |- span(I, J, Tns(A, B))

    # Product elimination (left projection): A⊗B  ⊢  A
    rule tensor_left
        : span(I, J, Tns(A, B))
        |- span(I, J, A)

    # Product elimination (right projection): A⊗B  ⊢  B
    rule tensor_right
        : span(I, J, Tns(A, B))
        |- span(I, J, B)

    semiring  LogProb
    start     S
    depth     6
}
