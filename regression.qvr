object Resp : 200
program model : Resp -> Resp
    intercept <- Normal(0.0, 5.0)
    beta_x <- Normal(0.0, 5.0)
    let beta_x_per_row = (beta_x * x)
    sigma <- HalfCauchy(2.0)
    let eta = (intercept + beta_x_per_row)
    let mu = eta
    observe y : Resp <- Normal(mu, sigma)
    return y

export model
